generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { LEARNER PARENT TEACHER CONTENT_CREATOR REVIEWER SUPPORT ADMIN }
enum ContentStatus { DRAFT REVIEW APPROVED PUBLISHED ARCHIVED }
enum ActivityType { LESSON EXERCISE SPEAKING WRITING LISTENING CONVERSATION EXAM REVIEW }

model User { id String @id @default(cuid()) email String @unique displayName String role Role @default(LEARNER) createdAt DateTime @default(now()) profile Profile? progress LearningProgress[] sessions LearningSession[] attempts Attempt[] xp XPTransaction[] achievements UserAchievement[] certificates Certificate[] @@index([role]) }
model Profile { id String @id @default(cuid()) userId String @unique uiLanguageCode String @default("en") dailyMinutes Int @default(10) goals Json? childSafeMode Boolean @default(false) user User @relation(fields:[userId], references:[id], onDelete:Cascade) }
model Language { id String @id @default(cuid()) code String @unique name String nativeName String scriptId String region String? framework String? isActive Boolean @default(true) script Script @relation(fields:[scriptId], references:[id]) courses Course[] vocabulary Vocabulary[] grammar GrammarConcept[] }
model Script { id String @id @default(cuid()) code String @unique name String direction String @default("ltr") transliterationName String? languages Language[] }
model Course { id String @id @default(cuid()) languageId String levelCode String title String description String? status ContentStatus @default(DRAFT) language Language @relation(fields:[languageId], references:[id]) units Unit[] @@unique([languageId, levelCode]) }
model Unit { id String @id @default(cuid()) courseId String order Int title String description String? course Course @relation(fields:[courseId], references:[id], onDelete:Cascade) lessons Lesson[] @@unique([courseId, order]) }
model Lesson { id String @id @default(cuid()) unitId String order Int slug String title String description String? status ContentStatus @default(DRAFT) durationSec Int @default(600) unit Unit @relation(fields:[unitId], references:[id], onDelete:Cascade) video Video? exercises Exercise[] @@unique([unitId, order]) @@unique([unitId, slug]) }
model Video { id String @id @default(cuid()) lessonId String @unique provider String assetKey String durationSec Int subtitles Json? lesson Lesson @relation(fields:[lessonId], references:[id], onDelete:Cascade) }
model Character { id String @id @default(cuid()) languageId String name String role String traits Json? language Language @relation(fields:[languageId], references:[id]) }
model Vocabulary { id String @id @default(cuid()) languageId String lemma String transliteration String? meaning String partOfSpeech String? audioKey String? examples Json? language Language @relation(fields:[languageId], references:[id]) @@unique([languageId, lemma]) }
model GrammarConcept { id String @id @default(cuid()) languageId String code String title String explanation String examples Json? language Language @relation(fields:[languageId], references:[id]) @@unique([languageId, code]) }
model Exercise { id String @id @default(cuid()) lessonId String type String prompt Json correctAnswer Json? difficulty Int @default(1) skill String lesson Lesson @relation(fields:[lessonId], references:[id], onDelete:Cascade) questions Question[] }
model Question { id String @id @default(cuid()) exerciseId String prompt Json options Json? answer Json rubric Json? exercise Exercise @relation(fields:[exerciseId], references:[id], onDelete:Cascade) }
model Attempt { id String @id @default(cuid()) userId String activity ActivityType score Float? latencyMs Int? response Json? feedback Json? createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id], onDelete:Cascade) @@index([userId, createdAt]) }
model LearningProgress { id String @id @default(cuid()) userId String languageId String levelCode String mastery Float @default(0) xp Int @default(0) streakDays Int @default(0) lastActiveAt DateTime? user User @relation(fields:[userId], references:[id], onDelete:Cascade) language Language @relation(fields:[languageId], references:[id]) @@unique([userId, languageId, levelCode]) }
model LearningSession { id String @id @default(cuid()) userId String languageId String startedAt DateTime @default(now()) endedAt DateTime? minutes Int @default(0) events Json? user User @relation(fields:[userId], references:[id], onDelete:Cascade) }
model XPTransaction { id String @id @default(cuid()) userId String amount Int reason String createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id], onDelete:Cascade) @@index([userId, createdAt]) }
model Achievement { id String @id @default(cuid()) code String @unique title String description String criteria Json }
model UserAchievement { id String @id @default(cuid()) userId String achievementId String earnedAt DateTime @default(now()) user User @relation(fields:[userId], references:[id], onDelete:Cascade) achievement Achievement @relation(fields:[achievementId], references:[id]) @@unique([userId, achievementId]) }
model Test { id String @id @default(cuid()) languageId String levelCode String title String passScore Int durationMin Int sections Json status ContentStatus @default(DRAFT) language Language @relation(fields:[languageId], references:[id]) exams Exam[] }
model Exam { id String @id @default(cuid()) testId String version Int instructions Json? test Test @relation(fields:[testId], references:[id], onDelete:Cascade) }
model Certificate { id String @id @default(cuid()) userId String certificateId String @unique languageId String levelCode String score Float issuedAt DateTime @default(now()) verificationToken String @unique user User @relation(fields:[userId], references:[id]) language Language @relation(fields:[languageId], references:[id]) }
model Notification { id String @id @default(cuid()) userId String title String body String readAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id], onDelete:Cascade) @@index([userId, createdAt]) }
model AIInteraction { id String @id @default(cuid()) userId String? service String model String? input Json output Json? latencyMs Int? createdAt DateTime @default(now()) user User? @relation(fields:[userId], references:[id]) @@index([userId, createdAt]) }
model ContentVersion { id String @id @default(cuid()) entityType String entityId String version Int payload Json status ContentStatus @default(DRAFT) reviewerId String? createdAt DateTime @default(now()) @@unique([entityType, entityId, version]) }
